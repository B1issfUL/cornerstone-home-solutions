rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public aggregate counters only. The owner can still inspect the document
    // if a privileged writer ever adds a field outside the public schema.
    match /siteSettings/homepageStats {
      allow get: if isOwner() || (
        resource.data.keys().hasOnly(statsFields())
        && validCounters(resource.data)
        && resource.data.updatedAt is timestamp
        && resource.data.updatedBy == "chsmadesimple@gmail.com"
      );
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(statsFields())
        && validStats(request.resource.data);
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(statsFields())
        && validStats(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner() {
      return request.auth != null
        && request.auth.token.email == "chsmadesimple@gmail.com"
        && request.auth.token.email_verified == true;
    }

    function statsFields() {
      return ['propertiesReviewed', 'estimatedTimelineDays', 'estimatedCashOffer',
        'reviewCompletePercent', 'updatedAt', 'updatedBy'];
    }

    function wholeNumber(value, max) {
      return value is int && value >= 0 && value <= max;
    }

    function validStats(data) {
      return validCounters(data)
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.token.email;
    }

    function validCounters(data) {
      return wholeNumber(data.propertiesReviewed, 1000000)
        && wholeNumber(data.estimatedTimelineDays, 3650)
        && wholeNumber(data.estimatedCashOffer, 100000000)
        && wholeNumber(data.reviewCompletePercent, 100);
    }
  }
}
